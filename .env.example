# Flyomint CMS public API (flyomint-cms server, no trailing slash)
# Used by the browser (forms, tracking) and by the server (content).
NEXT_PUBLIC_CMS_API_URL=http://localhost:5000/api/public

# Optional: server-only override (e.g. internal Docker/VPC hostname). Falls back to the value above.
# CMS_API_URL=http://cms:5000/api/public

# Public URL of this website (used for absolute metadata URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Existing booking backend (unchanged)
# NEXT_PUBLIC_BASE_URL=
# NEXT_PUBLIC_SIGNATURE_CODE=
